Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1
        - /Map1
        - /Particles1
        - /AMCLParticles1
        - /TruePose1
        - /MCLPose1
        - /RobotMarker1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 200
      Reference Frame: <Fixed Frame>
      Value: true
      Color: 40; 40; 40

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
      Value: true

    - Class: rviz_default_plugins/Marker
      Name: Particles
      Enabled: true
      Topic:
        Value: /particle_cloud
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true

    - Class: rviz_default_plugins/Marker
      Name: AMCLParticles
      Enabled: true
      Topic:
        Value: /amcl_particles_marker
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true

    - Class: rviz_default_plugins/Pose
      Name: TruePose
      Enabled: true
      Topic:
        Value: /true_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Head Length: 0.15
      Head Width: 0.1
      Shaft Length: 0.3
      Shaft Width: 0.05
      Shape: Arrow
      Value: true

    - Class: rviz_default_plugins/Pose
      Name: MCLPose
      Enabled: true
      Topic:
        Value: /mcl_pose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 100; 255
      Head Length: 0.15
      Head Width: 0.1
      Shaft Length: 0.3
      Shaft Width: 0.05
      Shape: Arrow
      Value: true

    - Class: rviz_default_plugins/Pose
      Name: AMCLPose
      Enabled: true
      Topic:
        Value: /amcl_pose_viz
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 255; 0
      Head Length: 0.15
      Head Width: 0.1
      Shaft Length: 0.3
      Shaft Width: 0.05
      Shape: Arrow
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Name: RobotMarker
      Enabled: true
      Topic:
        Value: /robot_marker
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true

    - Class: rviz_default_plugins/Path
      Name: RobotPath
      Enabled: true
      Topic:
        Value: /robot_path
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 255; 255; 255
      Line Style: Lines
      Line Width: 0.05
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Name: Landmarks
      Enabled: true
      Topic:
        Value: /landmark_markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true

  Global Options:
    Background Color: 10; 14; 20
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Near Clip Distance: 0.01
      Scale: 50
      Target Frame: map
      X: 0
      Y: 0
      Angle: 0
      Enable Stereo Rendering:
        Value: false
Window Geometry:
  Width: 1200
  Height: 900
  X: 100
  Y: 100
  Displays:
    collapsed: false
  Views:
    collapsed: true
